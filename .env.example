# ============================================================
# TRONIC Response — environment configuration
# Copy to .env.local and fill in. NEVER commit real values.
# ============================================================

# --- Supabase (project: create at https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by workers and webhook handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (BullMQ queues; Railway/Upstash/VPS) ---
REDIS_URL=redis://localhost:6379

# --- Respond.io ---
# Developer API token from Respond.io workspace settings.
# (RESPOND_IO_* spec names are supported; RESPONDIO_* legacy names still work.)
RESPOND_IO_API_TOKEN=
RESPOND_IO_API_URL=https://api.respond.io/v2
# Connected WhatsApp channel ID in Respond.io.
RESPOND_IO_CHANNEL_ID=582135
# Approved marketing template used by broadcast campaigns.
RESPOND_IO_TEMPLATE_NAME=tronic_special_offers
# Secret used to verify incoming Respond.io webhook signatures (if plan supports it).
RESPONDIO_WEBHOOK_SECRET=

# --- Broadcasting safety ---
# HARD kill switch for live customer broadcasts. Keep false until the pilot is
# explicitly approved. (A second in-app switch must ALSO be enabled by a Super
# Admin — both are required; everything else fails closed.)
ENABLE_LIVE_BROADCASTING=false

# --- Meta Commerce / Product Catalog ---
# System-user access token with catalog_management permission.
META_ACCESS_TOKEN=
META_CATALOG_ID=
META_BUSINESS_ID=
META_GRAPH_API_VERSION=v21.0

# --- Application ---
# Public base URL of this deployment (APP_BASE_URL is an accepted alias).
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Default currency for prices (ISO 4217)
DEFAULT_CURRENCY=TZS
# Official TRONIC WhatsApp number in E.164 without '+' (for wa.me links on the public catalog)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Secret for signing expiring personalized catalog links (any long random string)
CATALOG_LINK_SECRET=
